LLM_API_BASE=https://api.deepseek.cn/v1/
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-flash

TAVILY_API_KEY=tvly-xxx

# Jina Reader API base URL (default: https://r.jina.ai)
# Use https://r.jinaai.cn for China mainland
JINA_WEB_FETCH_BASE=https://r.jina.ai

LANGSMITH_TRACING=true
LANGCHAIN_API_KEY=lsv2_xxxx
LANGSMITH_PROJECT="finders"

# Workspace (sandbox file operations root directory)
FINDERS_WORKSPACE=~/.finders/workspace
